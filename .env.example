DATABASE_URL=postgresql://<database-user>:<database-password>@<database-host>:5432/<database-name>
TEST_DATABASE_URL=postgresql://<database-user>:<database-password>@<database-host>:5432/<test-database-name>
PORT=3000
JWT_SECRET=<random-secret-of-at-least-32-characters>
AUTH_ADMIN_EMAIL=<admin-email>
AUTH_ADMIN_PASSWORD_HASH=<bcrypt-hash-of-admin-password>
AUTH_STAFF_EMAIL=<staff-email>
AUTH_STAFF_PASSWORD_HASH=<bcrypt-hash-of-staff-password>
